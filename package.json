{
  "name": "c8",
  "version": "11.0.0",
  "description": "output coverage reports using Node.js' built in coverage",
  "main": "./lib/main.js",
  "type": "module",
  "bin": "./bin/c8.js",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/43081j/tinyc8#readme",
  "bugs": {
    "url": "https://github.com/43081j/tinyc8/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/tinyc8.git"
  },
  "files": [
    "lib",
    "bin",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts"
  ],
  "scripts": {
    "build:clean": "node -e \"require('fs').rmSync('./lib', { recursive: true, force: true })\"",
    "build": "npm run build:clean && tsgo",
    "lint:js": "oxlint src",
    "lint:format": "oxfmt --check src",
    "lint": "npm run lint:js && npm run lint:format",
    "format": "oxfmt --write src",
    "test": "node ./bin/c8.js node --test ./test/*.js",
    "test:coverage": "node ./bin/c8.js --check-coverage node --test ./test/*.js"
  },
  "keywords": [
    "coverage",
    "v8",
    "test",
    "istanbul",
    "profiler",
    "inspector",
    "node"
  ],
  "author": "James Garbutt (https://github.com/43081j)",
  "license": "MIT",
  "dependencies": {
    "@bcoe/v8-coverage": "^1.0.1",
    "@istanbuljs/schema": "^0.1.3",
    "istanbul-lib-coverage": "^3.2.0",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.6",
    "v8-to-istanbul": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260518.1",
    "monocart-coverage-reports": "^2.12.11",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0"
  },
  "peerDependencies": {
    "monocart-coverage-reports": "^2"
  },
  "peerDependenciesMeta": {
    "monocart-coverage-reports": {
      "optional": true
    }
  },
  "engines": {
    "node": "20 || >=22"
  }
}
